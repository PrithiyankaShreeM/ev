# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
# Set to your MongoDB connection string (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/wattstop

# Authentication Secret
JWT_SECRET=wattstop_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Sarvam AI Voice Assistant API
# Obtain your key from https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
